# ==============================================================================
# Trading 212 Daily Buy/Sell Advisor Configuration
# ==============================================================================
# How to generate your Trading 212 API Key (Takes 30 seconds):
#   1. Open the Trading 212 app (or web platform) -> Settings -> API (Beta)
#   2. Click "Generate API Key"
#   3. Enable Read permissions for: Account Data, Portfolio, Orders, History
#   4. Copy your API Key ID and Secret Key below
# ==============================================================================

# --- YOUR PROFILE & TRADING 212 API ---
ACCOUNT_NAME=Main
T212_KEY_ID=your_t212_key_id_here
T212_SECRET=your_t212_secret_key_here

# Environment: "live" (for Real Money Invest / ISA) or "demo" (for Practice account)
T212_ENV=live
CASH_CURRENCY=GBP

# --- PORTFOLIO LIQUIDITY & RISK GUARDRAILS ---
# Minimum protected cash withdrawal floor in £ GBP (never spent on buy orders)
MIN_CASH_RESERVE_GBP=1500.0

# Optional: Comma-separated tickers to exclude from BUY recommendations
EXCLUDED_TICKERS=

# --- OPTIONAL: DAILY EMAIL DIGEST (GMAIL SMTP) ---
# Leave blank if you only want terminal & interactive web dashboard reports.
# To enable email digests, create a 16-char Google App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=

# --- OPTIONAL: SECOND TRADING 212 ACCOUNT (e.g. Partner or separate ISA/Invest) ---
SECOND_ACCOUNT_NAME=
T212_KEY_ID_2=
T212_SECRET_2=
MIN_CASH_RESERVE_2=500.0

# --- OPTIONAL SETTINGS (all off by default; see README "Optional Settings") ---
# Earmarked money with a fixed purpose: excluded from the investable book and never traded
# (comma-separated, e.g. CSH2.L; "none" or blank = no earmarks)
EARMARKED_TICKERS=

# Holdings outside Trading 212 (e.g. shares at another broker or from a workplace share scheme). Never traded;
# vested value counts towards concentration and cluster caps. Keys are your account names. Example:
# OUTSIDE_HOLDINGS_JSON={"Main": [{"ticker": "MSFT", "shares_vested": 10, "shares_unvested": 5, "currency": "USD"}]}
OUTSIDE_HOLDINGS_JSON=

# Temporary increase of an account's protected cash floor until a date (inclusive), e.g. while cash you plan
# to withdraw sits in the account. Example:
# RESERVE_TOPUPS_JSON={"Main": {"amount_gbp": 2000, "until": "2026-12-31"}}
RESERVE_TOPUPS_JSON=

# Tax wrapper per account (informational only): ACCOUNT_WRAPPER (first account), ACCOUNT_WRAPPER_2 (second
# account) or ACCOUNT_WRAPPER_<NAME> (e.g. ACCOUNT_WRAPPER_MAIN=ISA). Values: ISA, GIA, SIPP, ...
ACCOUNT_WRAPPER=
ACCOUNT_WRAPPER_2=

# Leverage policy: maximum weight in 3x daily-leveraged ETFs as a fraction (default 0.08 = 8%).
# 0 = exit 3x ETFs entirely (any you hold is flagged as a full SELL).
MAX_LEVERAGED_ETF_PCT=0.08

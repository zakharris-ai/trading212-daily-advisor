# ==============================================================================
# Trading 212 Daily Buy/Sell Advisor Configuration
# ==============================================================================
# How to generate your Trading 212 API Key (Takes 30 seconds):
#   1. Open the Trading 212 app (or web platform) -> Settings -> API (Beta)
#   2. Click "Generate API Key"
#   3. Enable Read permissions for: Account Data, Portfolio, Orders, History
#   4. Copy your API Key ID and Secret Key below
# ==============================================================================

# --- YOUR PROFILE & TRADING 212 API ---
ACCOUNT_NAME=Main
T212_KEY_ID=your_t212_key_id_here
T212_SECRET=your_t212_secret_key_here

# Environment: "live" (for Real Money Invest / ISA) or "demo" (for Practice account)
T212_ENV=live
CASH_CURRENCY=GBP

# --- PORTFOLIO LIQUIDITY & RISK GUARDRAILS ---
# Minimum protected cash withdrawal floor in £ GBP (never spent on buy orders)
MIN_CASH_RESERVE_GBP=1500.0

# Optional: Comma-separated tickers to exclude from BUY recommendations
EXCLUDED_TICKERS=

# --- OPTIONAL: DAILY EMAIL DIGEST (GMAIL SMTP) ---
# Leave blank if you only want terminal & interactive web dashboard reports.
# To enable email digests, create a 16-char Google App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=

# --- OPTIONAL: SECOND TRADING 212 ACCOUNT (e.g. Partner or separate ISA/Invest) ---
SECOND_ACCOUNT_NAME=
T212_KEY_ID_2=
T212_SECRET_2=
MIN_CASH_RESERVE_2=500.0
